@page "/recettes"
@implements IDisposable
@inject CollectionStore Store

<PageTitle>Recettes — Hobby Warhammer</PageTitle>

<header class="page-header">
    <h1>📜 Recettes</h1>
    <div class="header-sub">@(Store.Data?.Recipes.Count ?? 0) recette(s) de peinture</div>
</header>

<SyncBanner />

<div class="filters">
    <input class="form-input" type="search" placeholder="🔍 Nom, tag, peinture…" @bind="_search" @bind:event="oninput" />
</div>

@if (Store.CanEdit)
{
    <a class="action-btn btn-primary" href="recette/nouvelle">➕ Nouvelle recette</a>
}

@if (Store.Data is null)
{
    <p class="muted">Chargement…</p>
}
else if (!Filtered.Any())
{
    <p class="empty">Aucune recette@(Store.Data.Recipes.Count > 0 ? " pour cette recherche" : " pour l'instant").</p>
}
else
{
    @foreach (var group in Filtered.GroupBy(r => string.IsNullOrWhiteSpace(r.Faction) ? "Générique" : r.Faction).OrderBy(g => g.Key))
    {
        <section class="card">
            <h2 class="card-title">@group.Key</h2>
            @foreach (var recipe in group.OrderBy(r => r.Name))
            {
                var missing = Store.MissingPaints(recipe).Count();
                <a class="list-row" href="recette/@recipe.Id">
                    <span class="list-row-main">
                        <b>@recipe.Name</b>
                        <small>
                            @recipe.Steps.Count étape(s)
                            @if (missing > 0) { <span class="warn-text"> · 🛒 @missing à acheter</span> }
                        </small>
                        <span class="swatch-row">
                            @foreach (var step in recipe.Steps)
                            {
                                <PaintSwatch Paint="Store.PaintById(step.PaintId)" />
                            }
                        </span>
                    </span>
                    <span class="list-row-arrow">›</span>
                </a>
            }
        </section>
    }
}

@code {
    private string? _search;

    private IEnumerable<Recipe> Filtered =>
        (Store.Data?.Recipes ?? []).Where(Matches);

    private bool Matches(Recipe r)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;
        var q = _search.Trim();
        return r.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (r.Faction?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || r.Tags.Any(t => t.Contains(q, StringComparison.OrdinalIgnoreCase))
            || r.Steps.Any(s => Store.PaintLabel(s).Contains(q, StringComparison.OrdinalIgnoreCase)
                                || (s.Area?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
    }

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        await Store.EnsureLoadedAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.Changed -= OnChanged;
}
