@page "/recettes"
@implements IDisposable
@inject CollectionStore Store

<PageTitle>Recettes — Figouz de la Honte</PageTitle>

<header class="page-header">
    <h1>📜 Recettes</h1>
    <div class="header-sub">@Store.Recipes.Count recette(s) de peinture</div>
</header>

<SyncBanner />

<div class="filters">
    <input class="form-input" type="search" placeholder="🔍 Nom, zone, peinture…" @bind="_search" @bind:event="oninput" />
</div>

@if (!Store.Loaded)
{
    <p class="muted">Chargement…</p>
}
else if (!Filtered.Any())
{
    <p class="empty">Aucune recette@(Store.Recipes.Count > 0 ? " pour cette recherche" : " pour l'instant").</p>
}
else
{
    @foreach (var group in Filtered.GroupBy(r => string.IsNullOrWhiteSpace(r.Faction) ? "Générique" : r.Faction).OrderBy(g => g.Key))
    {
        <section class="card">
            <h2 class="card-title">@group.Key</h2>
            @foreach (var recipe in group)
            {
                <a class="list-row" href="recette/@recipe.Slug">
                    <span class="list-row-main">
                        <b>@recipe.Name</b>
                        <small>
                            @recipe.Steps.Count étape(s)
                            @{ var areas = Areas(recipe); }
                            @if (areas.Length > 0) { <text> · @areas</text> }
                        </small>
                    </span>
                    <span class="list-row-arrow">›</span>
                </a>
            }
        </section>
    }
}

@code {
    private string? _search;

    private IEnumerable<Recipe> Filtered => Store.Recipes.Where(Matches);

    private static string Areas(Recipe r) =>
        string.Join(", ", r.Steps.Select(s => s.Area).Where(a => !string.IsNullOrWhiteSpace(a)).Distinct());

    private bool Matches(Recipe r)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;
        var q = _search.Trim();
        return r.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (r.Faction?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || r.Tags.Any(t => t.Contains(q, StringComparison.OrdinalIgnoreCase))
            || r.Steps.Any(s => s.Paint.Contains(q, StringComparison.OrdinalIgnoreCase)
                                || (s.Area?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
    }

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        await Store.EnsureLoadedAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.Changed -= OnChanged;
}
