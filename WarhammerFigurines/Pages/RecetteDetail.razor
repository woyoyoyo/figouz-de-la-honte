@page "/recette/{Id}"
@implements IDisposable
@inject CollectionStore Store
@inject IJSRuntime JS

<PageTitle>@(Recipe?.Name ?? "Recette") — Figouz de la Honte</PageTitle>

<a class="back-link" href="recettes">‹ Recettes</a>

@if (!Store.Loaded)
{
    <p class="muted">Chargement…</p>
}
else if (Recipe is null)
{
    <p class="empty">Recette introuvable.</p>
}
else
{
    <header class="page-header">
        <h1>@Recipe.Name</h1>
        <div class="header-sub">@(string.IsNullOrWhiteSpace(Recipe.Faction) ? "Recette générique" : Recipe.Faction)</div>
        @if (Recipe.Tags.Count > 0)
        {
            <div class="chips">
                @foreach (var tag in Recipe.Tags) { <span class="chip chip-header">#@tag</span> }
            </div>
        }
    </header>

    <SyncBanner />

    @if (!string.IsNullOrWhiteSpace(Recipe.Description))
    {
        <section class="card"><p class="notes">@Recipe.Description</p></section>
    }

    @foreach (var area in Recipe.Steps.Select((s, i) => (Step: s, Num: i + 1)).GroupBy(x => string.IsNullOrWhiteSpace(x.Step.Area) ? "Général" : x.Step.Area))
    {
        <section class="card">
            <h2 class="card-title">@area.Key</h2>
            <ol class="steps">
                @foreach (var (step, num) in area)
                {
                    <li class="step-row">
                        <span class="step-num">@num</span>
                        <span class="step-main">
                            <b>@step.Paint</b>
                            <small>@step.Technique</small>
                            @if (!string.IsNullOrWhiteSpace(step.Notes)) { <small class="muted">@step.Notes</small> }
                        </span>
                    </li>
                }
            </ol>
        </section>
    }

    var minis = Store.MiniaturesUsing(Recipe.Slug).ToList();
    @if (minis.Count > 0)
    {
        <section class="card">
            <h2 class="card-title">⚔️ Utilisée sur</h2>
            @foreach (var mini in minis)
            {
                <a class="list-row" href="figurine/@mini.Slug">
                    <span class="list-row-main"><b>@mini.Name</b></span>
                    <StatusBadge Status="mini.Status" />
                </a>
            }
        </section>
    }

    <button class="action-btn" @onclick="CopyAsync">📋 Copier le texte</button>
    @if (_info is not null) { <div class="sync-status sync-ok">@_info</div> }
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private Recipe? Recipe => Store.RecipeBySlug(Id);
    private string? _info;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        await Store.EnsureLoadedAsync();
    }

    protected override void OnParametersSet() => _info = null;

    /// <summary>Texte brut de la recette, pour la partager (Discord, WhatsApp…).</summary>
    private async Task CopyAsync()
    {
        var r = Recipe!;
        var lines = new List<string> { $"🎨 {r.Name}" + (r.Faction is null ? "" : $" — {r.Faction}") };
        if (!string.IsNullOrWhiteSpace(r.Description)) lines.Add(r.Description);
        foreach (var area in r.Steps.GroupBy(s => string.IsNullOrWhiteSpace(s.Area) ? "Général" : s.Area))
        {
            lines.Add("");
            lines.Add($"▸ {area.Key}");
            lines.AddRange(area.Select(s => $"  • {s.Technique} : {s.Paint}"
                                            + (string.IsNullOrWhiteSpace(s.Notes) ? "" : $" ({s.Notes})")));
        }
        await JS.InvokeVoidAsync("hobby.copyText", string.Join("\n", lines));
        _info = "📋 Recette copiée.";
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.Changed -= OnChanged;
}
