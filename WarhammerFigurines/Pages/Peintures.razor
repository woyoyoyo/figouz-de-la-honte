@page "/peintures"
@implements IDisposable
@inject CollectionStore Store

<PageTitle>Peintures — Figouz de la Honte</PageTitle>

<header class="page-header">
    <h1>🎨 Peintures</h1>
    <div class="header-sub">@Store.PaintsUsed.Count() peinture(s) citée(s) dans tes recettes</div>
</header>

<SyncBanner />

<div class="filters">
    <input class="form-input" type="search" placeholder="🔍 Rechercher une peinture…" @bind="_search" @bind:event="oninput" />
</div>

@if (!Store.Loaded)
{
    <p class="muted">Chargement…</p>
}
else if (!Filtered.Any())
{
    <p class="empty">Aucune peinture@(Store.Recipes.Count > 0 ? " pour cette recherche" : " : ajoute une recette").</p>
}
else
{
    @foreach (var brand in Filtered.GroupBy(p => Labels.BrandOf(p.Paint)).OrderBy(g => g.Key == "Autres").ThenBy(g => g.Key))
    {
        <section class="card">
            <h2 class="card-title">@brand.Key <small>(@brand.Count())</small></h2>
            @foreach (var (paint, recipes) in brand)
            {
                <div class="list-row">
                    <span class="list-row-main">
                        <b>@paint</b>
                        <small>
                            @for (var i = 0; i < recipes.Count; i++)
                            {
                                var recipe = recipes[i];
                                @(i > 0 ? ", " : "")<a href="recette/@recipe.Slug">@recipe.Name</a>
                            }
                        </small>
                    </span>
                </div>
            }
        </section>
    }
    <p class="form-hint">Liste calculée à partir des recettes : pour la modifier, modifie les recettes.</p>
}

@code {
    private string? _search;

    private IEnumerable<(string Paint, List<Recipe> Recipes)> Filtered =>
        Store.PaintsUsed.Where(p => string.IsNullOrWhiteSpace(_search)
                                    || p.Paint.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        await Store.EnsureLoadedAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.Changed -= OnChanged;
}
