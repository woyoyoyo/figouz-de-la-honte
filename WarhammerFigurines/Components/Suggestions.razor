@* <datalist> réutilisable pour l'autocomplétion des champs texte. *@
<datalist id="@Id">
    @foreach (var value in Values)
    {
        <option value="@value"></option>
    }
</datalist>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public IEnumerable<string> Values { get; set; } = [];
}
