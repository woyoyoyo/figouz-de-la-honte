@implements IDisposable
@inject CollectionStore Store
@inject SettingsService Config

@if (Store.LoadError is not null)
{
    <div class="sync-status sync-warn">
        ⚠️ @(Store.Source == DataSource.Cache ? "Hors ligne — copie locale affichée." : "Chargement impossible.")
        <small>@Store.LoadError</small>
    </div>
}
else if (Store.Source == DataSource.Cache)
{
    <div class="sync-status sync-readonly">📴 Hors ligne — copie du @Store.LastSync?.ToString("dd/MM HH:mm").</div>
}
else if (Store.Source == DataSource.GitHub && !Config.CanSave)
{
    <div class="sync-status sync-readonly">👁️ Lecture seule — <a href="parametres">ajoute ton token</a> pour modifier.</div>
}

@code {
    protected override void OnInitialized() => Store.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.Changed -= OnChanged;
}
